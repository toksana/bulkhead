{
  "name": "@bulkhead/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript, ESLint and Prettier configuration.",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.bundler.json": "./tsconfig.bundler.json",
    "./tsconfig.node.json": "./tsconfig.node.json",
    "./eslint": "./eslint.config.js",
    "./prettier": "./prettier.config.js",
    "./mf-shared": "./mf-shared.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@rsbuild/core": "2.3.2",
    "@types/node": "26.6.6",
    "postcss": "8.5.32",
    "vitest": "5.1.0"
  }
}
